# Python bytecode and interpreter caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Test, coverage, type-checker, and linter caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.pytype/
.ruff_cache/

# Build and packaging artifacts
build/
dist/
*.egg-info/

# Local configuration and secrets
.env
.env.*
!.env.example

# Runtime output
*.log
*.pid

# Editor swap and backup files
*.swp
*.swo
*~

# Arduino CLI/IDE local build state
.arduinoIDE/
.arduino15/

# Local editor and operating-system files
.DS_Store
Thumbs.db
.idea/
.vscode/
